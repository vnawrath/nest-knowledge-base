{
  "name": "llm-wiki",
  "private": true,
  "version": "0.1.0",
  "description": "Private knowledge-work app where an LLM incrementally maintains a persistent markdown wiki from immutable raw sources.",
  "license": "UNLICENSED",
  "scripts": {
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "nest build",
    "build": "npm run build:server && npm run build:client",
    "format": "prettier --write \"src/**/*.ts\" \"client/**/*.{ts,tsx,html,json}\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,client/src,test}/**/*.{ts,tsx}\" --fix",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/swagger": "11.2.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "helmet": "8.1.0",
    "joi": "18.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "serve-static": "2.2.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.17",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.15.21",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.15",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "15.15.0",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2",
    "vite": "8.0.13"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core"
    ]
  }
}
