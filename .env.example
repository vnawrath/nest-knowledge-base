# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# Database
DB_PATH=data/app.db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Auth
JWT_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10
